{
  "name": "a2zacademy-public",
  "version": "1.0.0",
  "private": true,
  "description": "A2Z Academy - Public Website & Hackathon Portal (Vite + React + Express)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:all": "npm run build && npm run prerender",
    "prerender": "tsx scripts/prerender.ts",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"server/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.4.2",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "dotenv": "^18.0.4",
    "express": "^4.19.2",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.378.0",
    "nodemailer": "^6.9.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^6.23.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.23",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.38",
    "puppeteer-core": "^23.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.0"
  }
