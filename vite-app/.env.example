# ===== PUBLIC CLIENT VARIABLES (prefixed with VITE_, exposed to the browser) =====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_WHATSAPP_GROUP_URL=
VITE_SITE_URL=https://a2zacademy.co.in

# ===== SERVER-ONLY VARIABLES (never expose to browser) =====
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="A2Z Academy Hackathon <your-email@gmail.com>"
ADMIN_EMAIL=organizer@example.com

# Port the Express server listens on (defaults to 12000).
PORT=12000
