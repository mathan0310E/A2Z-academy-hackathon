# Normalize line endings in the repo (LF) for every text file.
* text=auto eol=lf

# These are always text, even if heuristics disagree.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.html text eol=lf
.env.local.example text eol=lf

# Never run diffs or EOL conversions on binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
